# Local demo configuration. `npm run setup` copies this to backend/.env
# (and fills in JWT_SECRET) when backend/.env does not exist. Never commit .env.
NODE_ENV=development
PORT=3000

# Local Postgres from docker-compose.yml. These are throwaway local credentials.
DATABASE_URL="postgresql://civic:civic@localhost:5432/civic_kalki"

# Filled in by `npm run setup`. Must be at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Optional. Without it the AI features show their labeled fallback
# (see docs/DEMO_SCRIPT.md, "AI-down path").
GEMINI_API_KEY=
# Optional. Model used for every AI call (default gemini-3.5-flash-lite) and the
# per-call timeout in milliseconds (default 15000).
# GEMINI_MODEL=
# AI_TIMEOUT_MS=

FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# 0 = no reverse proxy in front of the server (local).
TRUST_PROXY_HOPS=0
